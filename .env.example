# Cria uma app em https://dev.twitch.tv/console/apps (Category: Chat Bot)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Tem de ser igual ao "OAuth Redirect URL" da app Twitch
REDIRECT_URI=http://localhost:3000/auth/callback
# Login do teu canal (minúsculas, sem #)
CHANNEL=
# Password do painel (utilizador: admin)
PANEL_PASSWORD=muda-isto
PORT=3000
